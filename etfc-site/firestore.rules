rules_version = '2';

// ── ETFC FIRESTORE SECURITY RULES ───────────────────────────────────────
// Deploy with: firebase deploy --only firestore:rules
//
// IMPORTANT: replace the isAdmin() check below with real admin verification
// before going live. The placeholder checks a custom claim `admin: true` —
// you must set this via Firebase Admin SDK (Cloud Function or manual script)
// for ETFC's organizer account(s). Do NOT ship with an open admin check.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ── fights ── public read, admin-only write
    match /fights/{fightId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── fighters ── public read, admin-only write
    match /fighters/{fighterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── seatMap ── public read (to render availability), writes only via
    // admin (initial setup) or through a Cloud Function that runs the
    // seat-locking transaction — never allow direct client writes to
    // seat "sold" status, or two buyers can double-book a seat.
    match /seatMap/{seatId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── orders ── a user can create their own order and read only their
    // own orders. Only admin can update status (approve/reject) — this
    // is what prevents a buyer from marking their own order "confirmed".
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── bets ── same pattern as orders. Also gate creation on the global
    // bettingEnabled flag so bets can't be placed while the license is
    // still pending, even if someone bypasses the UI.
    match /bets/{betId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && get(/databases/$(database)/documents/config/site).data.bettingEnabled == true;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── users ── a user can read/update only their own profile document.
    // Admin can read all for support lookups.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── config ── public read (so the site can check bettingEnabled,
    // event date, license text, etc.), admin-only write.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
