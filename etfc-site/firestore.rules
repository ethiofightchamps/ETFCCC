rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /fights/{fightId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fighters/{fighterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seatMap/{seatId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /merchProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: public read allowed so verify.html works without login
    // Guest create allowed (no auth required for ticket/merch purchases)
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /merchOrders/{orderId} {
      allow create: if true;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Bets: guests can place, signed-in users can read their own
    match /bets/{betId} {
      allow create: if true;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /otpCodes/{email} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
